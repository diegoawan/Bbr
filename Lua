local autoDropState = { lastKey = nil, counts = {}, startCounts = {} }

local function getInventoryCount(itemName)
    local mainGui = plr.PlayerGui:FindFirstChild("MainGui")
    local list = mainGui and mainGui.RightPanel and mainGui.RightPanel.Inventory and mainGui.RightPanel.Inventory.List
    if not list then return 0 end
    local item = list:FindFirstChild(itemName)
    if not item then return 0 end
    local attrCount = item:GetAttribute("Count") or item:GetAttribute("Amount") or item:GetAttribute("Quantity")
    if attrCount then return tonumber(attrCount) end
    local qty = item:FindFirstChild("QuantityImage")
    local txt = qty and qty:FindFirstChild("QuantityText")
    if txt then return tonumber(txt.Text:gsub("%D", "")) or 0 end
    return 1
end

local function getLayoutOrder(itemName)
    local mainGui = plr.PlayerGui:FindFirstChild("MainGui")
    local list = mainGui and mainGui.RightPanel and mainGui.RightPanel.Inventory and mainGui.RightPanel.Inventory.List
    if not list then return nil end
    local item = list:FindFirstChild(itemName)
    return item and item.LayoutOrder
