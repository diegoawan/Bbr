local function updatePlantPreview()
    previewFolder:ClearAllChildren()
    if not S.ShowPlantBoxPreview then return end
    local hrp = getHRP(); if not hrp then return end
    local spacing = S.PlantBoxSpacingX or 5.1
    local rot = CFrame.Angles(0, math.rad(S.PlantBoxRotation or 0), 0)
    local baseX = math.floor(hrp.Position.X / spacing + 0.5) * spacing
    local baseZ = math.floor(hrp.Position.Z / spacing + 0.5) * spacing
    for r = -2, 2 do
        for c = -2, 2 do
            local x = baseX + c * spacing
            local z = baseZ + r * spacing
            local p = Instance.new("Part", previewFolder)
            p.Size = Vector3.new(4, 0.5, 4)
            p.Position = Vector3.new(x, hrp.Position.Y - 3, z)
            p.CFrame = CFrame.new(p.Position) * rot
            p.Anchored = true
            p.CanCollide = false
            p.Material = Enum.Material.Neon
            p.Color = Color3.fromRGB(0, 255, 100)
            p.Transparency = 0.7
        end
    end
end

