local function equipItem(name)
    local slot = getToolSlot(name)
    if slot then
        fireEquipTool(slot)
    else
        local c = plr.Character
        if c then
            local t = plr.Backpack:FindFirstChild(name)
            if t then c:FindFirstChildOfClass("Humanoid"):EquipTool(t) end
        end
    end
end

local function isToolEquipped(name)
    local pf = workspace:FindFirstChild("Players")
    if pf then
        local folder = pf:FindFirstChild(plr.Name)
        local tf = folder and folder:FindFirstChild("Tools")
        if tf and tf:FindFirstChild(name) then return true end
    end
    local c = plr.Character
    if c and c:FindFirstChild(name) then return true end
    return false
end

