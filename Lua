local function getGroundY(pos, excludeChar)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local list = {}
    if plr.Character then table.insert(list, plr.Character) end
    if excludeChar then table.insert(list, excludeChar) end
    params.FilterDescendantsInstances = list
    local hit = workspace:Raycast(pos + Vector3.new(0, 5, 0), Vector3.new(0, -500, 0), params)
    return hit and hit.Position.Y or (pos.Y - 4)
end

local GRAVITY = workspace.Gravity or 196.2
local function predictLanding(character, maxTime)
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local vel = hrp.AssemblyLinearVelocity
    local pos = hrp.Position
    local t = 0
    local step = 0.05
    local posXZ = Vector2.new(pos.X, pos.Z)
    local velXZ = Vector2.new(vel.X, vel.Z)
    while t <= maxTime do
        local xz = posXZ + velXZ * t
        local y = pos.Y + vel.Y * t - 0.5 * GRAVITY * t * t
        local gy = getGroundY(Vector3.new(xz.X, y, xz.Y))
        if y <= gy then
            return Vector3.new(xz.X, gy, xz.Y), t
        end
        t += step
    end
    return nil
end

local lastChestPlace = 0
local lastFallTriggered = false
local wasAirborne = false
local function stepAutoChest(dt)
    if not S.AutoChestEnabled then
        lastFallTriggered = false; wasAirborne = false; return
    end
    local c = plr.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if not hrp or not h then return end

    local airborne = h.FloorMaterial == Enum.Material.Air
    local predTime = S.AutoChestPredictionTime or 0.2
    local vel = hrp.AssemblyLinearVelocity or Vector3.zero
    local horizVel = Vector3.new(vel.X, 0, vel.Z)
    local feetY = hrp.Position.Y + vel.Y * predTime - 0.5 * GRAVITY * predTime * predTime
    local groundYFeet = getGroundY(Vector3.new(hrp.Position.X, feetY, hrp.Position.Z))
    local dy = feetY - groundYFeet

    local horizLead = horizVel * predTime
    local placeAnchor
    if S.AutoChestJumpPrediction then
        local land = predictLanding(c, 2.0)
        placeAnchor = land or Vector3.new(hrp.Position.X + horizLead.X, feetY, hrp.Position.Z + horizLead.Z)
    else
        placeAnchor = Vector3.new(hrp.Position.X + horizLead.X, feetY, hrp.Position.Z + horizLead.Z)
    end

    -- Forward offset
    local md = h.MoveDirection
    local forward
    if Vector3.new(md.X, 0, md.Z).Magnitude > 0.05 then
        forward = Vector3.new(md.X, 0, md.Z).Unit
    elseif horizVel.Magnitude > 0.15 then
        forward = horizVel.Unit
    else
        local lv = hrp.CFrame.LookVector
        forward = Vector3.new(lv.X, 0, lv.Z).Unit
    end

    local basePos = placeAnchor + forward * (S.AutoChestForwardOffset or 0)
    local chestX, chestZ = basePos.X, basePos.Z
    local groundYChest = getGroundY(Vector3.new(chestX, hrp.Position.Y, chestZ))
    local cf = CFrame.new(chestX, groundYChest, chestZ)

    if airborne then
        wasAirborne = true
        local vy = (hrp.AssemblyLinearVelocity and hrp.AssemblyLinearVelocity.Y) or 0
        if vy < 0 and not lastFallTriggered then
            local thresh = S.AutoChestFallThreshold or 0.6
            if dy > 0 and dy <= thresh then
                local now = tick()
                if now - lastChestPlace >= 0.02 then
                    firePlaceStructure(S.AutoChestSelectedChest or "Chest", cf)
                    lastChestPlace = now
                    lastFallTriggered = true
                end
            end
        end
    else
        if wasAirborne then
            lastFallTriggered = false
            wasAirborne = false
        end
    end
end
