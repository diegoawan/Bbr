local function getSandMoundAtSpot(spot)
    local res = workspace:FindFirstChild("Resources")
    if not res or not spot then return nil end
    local best, bd
    for _, m in ipairs(res:GetChildren()) do
        if m.Name == "Sand Mound" or m.Name == "_MOUND" then
            local ok, p = pcall(function() return m:GetPivot().Position end)
            if ok and p then
                local d = math.abs(p.X - spot.x) + math.abs(p.Z - spot.z)
                if d < 9 and (not bd or d < bd) then bd = d best = m end
            end
        end
    end
    return best
end

