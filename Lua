                                local dSq = (pp.Position - r.Position).Magnitude ^ 2
                                if dSq <= rangeSq then table.insert(candidates, { eid = eid, dSq = dSq }) end
                            end
                        end
                    end
                    table.sort(candidates, function(a, b) return a.dSq < b.dSq end)
                    for _, c in ipairs(candidates) do
                        if not S.AutoPickupEnabled then break end
                        firePickup(c.eid)
                        task.wait(S.PickupDelay or 0.01)
                    end
                end)
                task.wait(0.05)
            end
        end)
    end
end })
