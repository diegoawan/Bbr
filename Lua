                if d < 100 then
                    local hasGod = false
                    for name in pairs(godNames) do
                        if c:FindFirstChild(name) then hasGod = true break end
                    end
                    if hasGod and d < godD then godD = d godTarget = p end
                    if d < normalD then normalD = d normalTarget = p end
                end
            end
        end
    end
    local t = godTarget or normalTarget
    if not t then return end
    local c = t.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
