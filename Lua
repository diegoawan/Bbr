PACKET_IDS = {}
ByteNetReliable = nil
task.spawn(function()
    ByteNetReliable = ReplicatedStorage:WaitForChild("ByteNetReliable", 30)
end)

local function readPacketObjectId(packetObj)
    if type(packetObj) ~= "table" then return nil end
    for _, key in ipairs({ "id","Id","_id","packetId","packetID","ID" }) do
        local v = packetObj[key]
        if type(v) == "number" and v == v and v > 0 then return v end
    end
    return nil
end

local function syncPacketIDs()
    local mf = ReplicatedStorage:FindFirstChild("Modules")
    if not mf then return false end
    local pi = mf:FindFirstChild("Packets")
    if not pi then return false end
    local ok, pk = pcall(require, pi)
    if not ok or type(pk) ~= "table" then return false end
    local applied = 0
    for name, obj in pairs(pk) do
        local id = readPacketObjectId(obj)
        if id and PACKET_IDS[name] ~= id then
            PACKET_IDS[name] = id
            applied += 1
        end
    end
    return applied > 0
end
function getPacketId(name) return PACKET_IDS[name] end

task.spawn(function()
    for _ = 1, 20 do
        if syncPacketIDs() then break end
        task.wait(0.5)
    end
    while true do
        task.wait(30)
        pcall(syncPacketIDs)
    end
end)

