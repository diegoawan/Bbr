        local staff = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= plr then
                local role = getRole(p)
                if role then
                    local label = role:match("|%s*(.+)$") or role
                    label = label:gsub("^%s+", ""):gsub("%s+$", "")
