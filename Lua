local function executeQuickHut()
    local myR = getHRP()
    if not myR then return end
    local godTarget, normalTarget = nil, nil
    local godD, normalD = math.huge, math.huge
    local godNames = { ["God Halo"]=true, ["God Chestplate"]=true, ["God Legs"]=true }
    for _, p in ipairs(Players:GetPlayers()) do
