--  Pinch (place two walls around a target player)
-- =========================================================
local function getPinchPingMs()
    local ms
    pcall(function()
        local n = Stats:FindFirstChild("Network")
        local ss = n and n:FindFirstChild("ServerStatsItem")
        local dp = ss and ss:FindFirstChild("DataPing")
        if dp and dp.GetValue then ms = tonumber(dp:GetValue()) end
    end)
    if not ms then pcall(function() ms = plr:GetNetworkPing() * 1000 end) end
    return math.clamp(tonumber(ms) or 80, 1, 2000)
end

local pinchSmoothVel = Vector3.zero
local function firePinchBurst(dt)
    if not S.PinchEnabled then return end
    local target = nil
    if S.PinchTargetMode == "Auto Target Mode" then
        local closest, cd = nil, math.huge
        local myR = getHRP()
        if myR then
            for _, p in ipairs(Players:GetPlayers()) do
                if isTargetablePlayer(p) then
                    local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d = (hrp.Position - myR.Position).Magnitude
                        if d < cd then cd = d closest = p end
                    end
                end
            end
        end
        target = closest
    end
    if not target then return end
    local char = target.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local h = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp then return end

    local vel = hrp.AssemblyLinearVelocity or Vector3.zero
    pinchSmoothVel = pinchSmoothVel:Lerp(Vector3.new(vel.X, 0, vel.Z), math.clamp(dt * 14, 0.1, 0.5))
    local pingMs = getPinchPingMs()
    local predTime = math.clamp((pingMs / 1000) * (S.PinchPredictTime or 1) * 1.2, 0.04, 0.7)
    local moveDir
    if pinchSmoothVel.Magnitude > 1.25 then moveDir = pinchSmoothVel.Unit
    elseif h and h.MoveDirection.Magnitude > 0.15 then moveDir = Vector3.new(h.MoveDirection.X, 0, h.MoveDirection.Z).Unit
    else local lv = hrp.CFrame.LookVector moveDir = Vector3.new(lv.X, 0, lv.Z).Unit end

    local lead = moveDir * (math.max(0, pinchSmoothVel:Dot(moveDir)) * predTime)
    local targetBase = hrp.Position + lead
    local yOff = S.PinchYOffset or -3.5

    local rot = CFrame.Angles(0, math.rad(90), 0)
    local mid = Vector3.new(
        targetBase.X + (S.PinchShiftX or 0),
        targetBase.Y + yOff,
        targetBase.Z + (S.PinchShiftZ or 0)
    )

    local xBase = S.PinchXOffset or 1.60
    local zBase = S.PinchZOffset or 0
    local spacingDominant = math.abs(xBase) >= math.abs(zBase)
    local cf1, cf2
    if spacingDominant then
        cf1 = CFrame.new(mid.X + xBase, mid.Y, mid.Z + zBase) * rot
        cf2 = CFrame.new(mid.X - xBase, mid.Y, mid.Z + zBase) * rot
    else
        cf1 = CFrame.new(mid.X + xBase, mid.Y, mid.Z + zBase) * rot
        cf2 = CFrame.new(mid.X + xBase, mid.Y, mid.Z - zBase) * rot
    end

    local itemName = S.PinchItemName or "Crystal Gate"
    firePlaceStructure(itemName, cf1)
    firePlaceStructure(itemName, cf2)
end

RunService.Heartbeat:Connect(function(dt)
    if S.PinchEnabled then firePinchBurst(dt) end
end)

