local function getToolSlot(toolName)
    local GameUtil
    pcall(function() GameUtil = require(ReplicatedStorage.Modules.GameUtil) end)
    if not GameUtil then return nil end
    local tb = GameUtil.Data.toolbar
    if not tb then return nil end
    for i = 1, 6 do
