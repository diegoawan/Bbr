local BOOGA_GROUP_ID = 15829231
local function getRole(player)
    if not player then return nil end
    local ok1, inGroup = pcall(function() return player:IsInGroup(BOOGA_GROUP_ID) end)
    if not ok1 or not inGroup then return nil end
    local ok2, role = pcall(function() return player:GetRoleInGroup(BOOGA_GROUP_ID) end)
    if not ok2 then return nil end
    return role
end

