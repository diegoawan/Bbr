local alignPosition, alignAttachment0, alignAttachment1
local isTweening = false
local WALK_SPEED = 21
local restoreCollision

local function captureCollision()
    if not plr.Character then return end
    plr.Character:SetAttribute("Crystallized_OriginalCollide", 1)
end

restoreCollision = function()
    if plr.Character then
        local h = plr.Character:FindFirstChildOfClass("Humanoid")
        for _, p in pairs(plr.Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = true end
        end
        if h then
            h:ChangeState(Enum.HumanoidStateType.Running)
            h.PlatformStand = false
            h.Sit = false
            h.AutoRotate = true
        end
    end
end

local function noclipChar()
    if not plr.Character then return end
    for _, p in pairs(plr.Character:GetDescendants()) do
        if p:IsA("BasePart") then
            if isTweening then
                p.CanCollide = false
            else
                if not (p.Name:find("Leg") or p.Name:find("Foot")) then
                    p.CanCollide = false
                end
            end
        end
    end
end

local function createAlignPosition(hrp)
    if alignPosition then alignPosition:Destroy() end
    if alignAttachment0 then alignAttachment0:Destroy() end
    if alignAttachment1 then alignAttachment1:Destroy() end
    alignAttachment0 = Instance.new("Attachment", hrp)
    alignAttachment1 = Instance.new("Attachment", workspace.Terrain)
    alignPosition = Instance.new("AlignPosition")
    alignPosition.Attachment0 = alignAttachment0
    alignPosition.Attachment1 = alignAttachment1
    alignPosition.MaxForce = 400000
    alignPosition.MaxVelocity = 100
    alignPosition.Responsiveness = 200
    alignPosition.ApplyAtCenterOfMass = true
    alignPosition.Parent = hrp
end

local function tweenToWaypoint(hrp, h, target, speed)
    if not alignPosition then createAlignPosition(hrp) end
    alignAttachment1.WorldPosition = target
    alignPosition.MaxVelocity = speed
    isTweening = true
end

local function walkToWaypoint(hrp, h, target, speed)
    local bv = hrp:FindFirstChild("CrystallizedBodyVelocity")
    local bg = hrp:FindFirstChild("CrystallizedBodyGyro")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "CrystallizedBodyVelocity"
        bv.Parent = hrp
    end
    if not bg then
        bg = Instance.new("BodyGyro")
        bg.Name = "CrystallizedBodyGyro"
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 9000
        bg.Parent = hrp
    end
    local dir = target - hrp.Position
    local flat = Vector3.new(dir.X, 0, dir.Z)
    if flat.Magnitude > 0 then
        flat = flat.Unit
        bv.MaxForce = Vector3.new(math.huge, 0, math.huge)
        bv.Velocity = flat * speed
        bg.CFrame = CFrame.new(hrp.Position, hrp.Position + flat)
    end
    if tick() % 0.5 < 0.05 then h:MoveTo(target) end
end

-- =========================================================
--  AutoHeal (SmartHeal duty cycle)
-- =========================================================
local healFruitId = nil
local healHealthConn
local healLastTrackedHealth = nil
local healLastDamageTime = 0
local healDamageBurstHits = 0
local healAdaptiveDelay = 0
local healNoGainStreak = 0
local healRecentHitTimes = {}
local healRunning = false
local healActive = false
local smoothFps, smoothPingMs, lastPingSample = 60, 80, 0

local SMART_TRIGGER = 65
local SMART_RECOVER = 98
local SMART_ACTIVE = 7
local SMART_PAUSE = 0.30
local smartBursting, smartCycleStart = false, 0

local function getHealFruitId(name)
    local id = autoDiscoverItemID(name)
    if id then return id end
    local mainGui = plr.PlayerGui:FindFirstChild("MainGui")
    local list = mainGui and mainGui.RightPanel and mainGui.RightPanel.Inventory and mainGui.RightPanel.Inventory.List
    if list then
        local item = list:FindFirstChild(name)
        if item then return item:GetAttribute("ItemID") or item:GetAttribute("ID") end
    end
    return nil
end

local function getHealSlot(name)
    local mainGui = plr.PlayerGui:FindFirstChild("MainGui")
    local list = mainGui and mainGui.RightPanel and mainGui.RightPanel.Inventory and mainGui.RightPanel.Inventory.List
    if not list then return nil end
    local item = list:FindFirstChild(name)
    return item and item.LayoutOrder
end

local function getPingFpsScale(hpPct)
    local fps, ping = smoothFps, smoothPingMs
    local critical = (hpPct or 100) <= 45
    local fpsScale
    if fps < 8 then fpsScale = critical and 0.55 or 0.4
    elseif fps < 15 then fpsScale = critical and 0.7 or 0.6
    elseif fps < 25 then fpsScale = 0.8
    elseif fps < 40 then fpsScale = 0.92
    else fpsScale = 1 end
    local pingScale
    if ping <= 90 then pingScale = 1
    elseif ping <= 140 then pingScale = 0.9
    elseif ping <= 200 then pingScale = 0.8
    elseif ping <= 300 then pingScale = 0.7
    else pingScale = critical and 0.5 or 0.4 end
    return math.clamp(math.min(fpsScale, pingScale), critical and 0.45 or 0.32, 1)
end

local function getEffectiveCPS()
    local h = getHum()
    local hpPct = 100
    if h and h.MaxHealth > 0 then hpPct = (h.Health / h.MaxHealth) * 100 end
    local base
    if S.SmartHealEnabled then
        base = math.max(140, math.clamp(tonumber(S.HealCPS) or 120, 1, 500))
    else
        base = math.clamp(tonumber(S.HealCPS) or 120, 1, 500)
    end
    local scale = getPingFpsScale(hpPct)
    local cps = base * scale
    local floor = hpPct <= 30 and 30 or (hpPct <= 45 and 22 or 14)
    return math.clamp(cps, floor, base)
end

local function pruneHealHits(now)
    for i = #healRecentHitTimes, 1, -1 do
        if now - healRecentHitTimes[i] > (S.HealDoubleHitWindow or 0.65) then
            table.remove(healRecentHitTimes, i)
        end
    end
    healDamageBurstHits = #healRecentHitTimes
end

local function bindSmartHealHealthWatch(c)
    if healHealthConn then healHealthConn:Disconnect() healHealthConn = nil end
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if not h then return end
    healLastTrackedHealth = h.Health
    healHealthConn = h.HealthChanged:Connect(function(newHp)
        if not S.SmartHealEnabled then healLastTrackedHealth = newHp return end
        if healLastTrackedHealth and newHp < healLastTrackedHealth - 0.01 then
            local now = os.clock()
            table.insert(healRecentHitTimes, now)
            pruneHealHits(now)
            healLastDamageTime = now
            healAdaptiveDelay = math.max(0, healAdaptiveDelay * 0.45)
            healNoGainStreak = 0
        end
        healLastTrackedHealth = newHp
    end)
end
plr.CharacterAdded:Connect(function(c)
    if S.SmartHealEnabled then bindSmartHealHealthWatch(c) end
end)

local function executeHeal()
    local h = getHum()
    if not h or h.Health <= 0 then return end
    local hpPct = (h.Health / h.MaxHealth) * 100
    local allow = (S.SmartHealEnabled and smartBursting) or (hpPct <= (S.HealThreshold or 70))
    if not allow then return end

    local fName = S.HealFruit
    local fID = getHealFruitId(fName)
    local slotID = getHealSlot(fName)
    if fID and slotID then fireUseBagItem(slotID, fID) end
end

local function runSmartHealTick()
    local now = os.clock()
    pruneHealHits(now)
    local h = getHum()
    if not h or h.Health <= 0 then return 0.15 end
    local hpPct = (h.Health / h.MaxHealth) * 100

    if S.SmartHealEnabled then
        if not smartBursting then
            if hpPct <= SMART_TRIGGER then
                smartBursting = true
                smartCycleStart = now
            else
                return 0.08
            end
        elseif hpPct >= SMART_RECOVER then
            smartBursting = false
            smartCycleStart = 0
            return 0.08
        end
        local period = SMART_ACTIVE + SMART_PAUSE
        local elapsed = (now - smartCycleStart) % period
        if elapsed >= SMART_ACTIVE then
            return math.clamp(period - elapsed, 0.05, 0.25)
        end
    end
    executeHeal()
    local cps = getEffectiveCPS()
    return math.max(1 / cps, 0.008)
end

local function startAutoHealLoop()
    task.spawn(function()
        if S.SmartHealEnabled then bindSmartHealHealthWatch(plr.Character) end
        while S.AutoHealEnabled do
            local waitTime = runSmartHealTick()
            task.wait(waitTime)
        end
    end)
end

-- ping/fps sampler
task.spawn(function()
    RunService.Heartbeat:Connect(function(dt)
        if not S.AutoHealEnabled then return end
        if typeof(dt) == "number" and dt > 0 and dt < 2 then
            local instFps = 1 / math.max(dt, 0.001)
            local alpha = (dt >= 0.1) and 0.45 or 0.15
            smoothFps = smoothFps * (1 - alpha) + instFps * alpha
        end
        local now = os.clock()
        if now - lastPingSample >= 0.25 then
            lastPingSample = now
            local ms
            pcall(function()
                local n = Stats:FindFirstChild("Network")
                local ss = n and n:FindFirstChild("ServerStatsItem")
                local dp = ss and ss:FindFirstChild("DataPing")
                if dp and dp.GetValue then ms = tonumber(dp:GetValue()) end
            end)
            if not ms then pcall(function() ms = plr:GetNetworkPing() * 1000 end) end
            smoothPingMs = smoothPingMs * 0.65 + math.clamp(tonumber(ms) or 80, 1, 2000) * 0.35
        end
    end)
end)

