        task.spawn(function()
            while S.AutoPickupEnabled do
                pcall(function()
                    local r = getHRP(); if not r then return end
                    local folder = workspace:FindFirstChild("Items") or workspace:FindFirstChild("DroppedItems")
                    if not folder then return end
                    local rangeSq = (S.PickupRange or 50) ^ 2
                    local batch = S.PickupBatchSize or 150
                    local candidates = {}
                    for _, item in ipairs(folder:GetChildren()) do
                        if #candidates >= batch then break end
                        local eid = readEntityId(item)
                        if eid then
                            local pp = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")) or item
