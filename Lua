local function writeCFrame18(b, offset, cf)
    local pos = cf.Position
    local _, _, _, R00, R01, R02, R10, R11, R12, R20, R21, R22 = cf:GetComponents()
    local qx, qy, qz, qw
    local tr = R00 + R11 + R22
    if tr > 0 then
        local Sq = math.sqrt(tr + 1.0) * 2
        qw = 0.25 * Sq; qx = (R21 - R12) / Sq; qy = (R02 - R20) / Sq; qz = (R10 - R01) / Sq
    elseif (R00 > R11) and (R00 > R22) then
        local Sq = math.sqrt(1.0 + R00 - R11 - R22) * 2
        qw = (R21 - R12) / Sq; qx = 0.25 * Sq; qy = (R01 + R10) / Sq; qz = (R02 + R20) / Sq
    elseif R11 > R22 then
        local Sq = math.sqrt(1.0 + R11 - R00 - R22) * 2
        qw = (R02 - R20) / Sq; qx = (R01 + R10) / Sq; qy = 0.25 * Sq; qz = (R12 + R21) / Sq
    else
        local Sq = math.sqrt(1.0 + R22 - R00 - R11) * 2
        qw = (R10 - R01) / Sq; qx = (R02 + R20) / Sq; qy = (R12 + R21) / Sq; qz = 0.25 * Sq
    end
    local len = math.sqrt(qx*qx + qy*qy + qz*qz + qw*qw)
    qx, qy, qz, qw = qx/len, qy/len, qz/len, qw/len
    if qw < 0 then qx, qy, qz, qw = -qx, -qy, -qz, -qw end
    buffer.writef32(b, offset, pos.X)
    buffer.writef32(b, offset + 4, pos.Y)
    buffer.writef32(b, offset + 8, pos.Z)
    buffer.writei16(b, offset + 12, math.clamp(qx * 32767, -32768, 32767))
    buffer.writei16(b, offset + 14, math.clamp(qy * 32767, -32768, 32767))
    buffer.writei16(b, offset + 16, math.clamp(qz * 32767, -32768, 32767))
end

local function fireSwingTool(entries, hrp, opts)
    opts = opts or {}
    if not ByteNetReliable or not hrp or not entries or #entries == 0 then return end
    local swingId = getPacketId("SwingTool")
    if not swingId then return end

    local maxPerPacket = math.clamp(opts.maxPerPacket or 32, 1, 64)
    local timeStep = opts.timeStep or 0.01
    local baseTime = opts.baseTime or (time() - timeStep)
    local pktIdx = 0

    for startIdx = 1, #entries, maxPerPacket do
        if pktIdx > 0 then RunService.Heartbeat:Wait() end
        pktIdx += 1

        local batch = {}
        for i = startIdx, math.min(startIdx + maxPerPacket - 1, #entries) do
            table.insert(batch, entries[i])
        end
        local n = #batch
        local fromPos = opts.fromPos or hrp.Position
        local cf = opts.cframe
        if not cf then
            if n == 1 and typeof(batch[1].pos) == "Vector3" then
                cf = CFrame.lookAt(fromPos, batch[1].pos)
            else
                local sum, cnt = Vector3.zero, 0
                for _, t in ipairs(batch) do
                    if typeof(t.pos) == "Vector3" then sum += t.pos; cnt += 1 end
                end
                cf = (cnt > 0) and CFrame.lookAt(fromPos, sum / cnt) or hrp.CFrame
            end
        end

        local b = buffer.create(30 + 5 * n)
        buffer.writeu8(b, 0, 0)
        buffer.writeu8(b, 1, swingId)
        writeCFrame18(b, 2, cf)
        buffer.writeu16(b, 20, n)
        local o = 22
        for _, t in ipairs(batch) do
            buffer.writeu8(b, o, 0)
            buffer.writeu32(b, o + 1, math.floor(tonumber(t.eid) or 0))
            o += 5
        end
        buffer.writef64(b, o, baseTime + (pktIdx * timeStep))
        ByteNetReliable:FireServer(b)
    end
end

