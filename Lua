--  Auto Hit / Reach / Silent Aim
-- =========================================================
local autoHitLoopActive = false
local manualAttackLock = false
local reachOriginals = {}
local reachExcluded = { "bow","potion","sling","saddle","fishing rod","horn","shovel" }

local function isReachExcluded(tool)
    local n = string.lower(tool.Name or "")
    for _, kw in ipairs(reachExcluded) do
        if string.find(n, kw, 1, true) then return true end
    end
    return false
end

local function findReachHandle(tool)
    if not tool or not tool.Parent then return nil end
    if tool:IsA("Tool") then
        local h = tool:FindFirstChild("Handle")
        if h and h:IsA("BasePart") then return h end
    end
    local h = tool:FindFirstChild("Handle", true)
    if h and h:IsA("BasePart") then return h end
    return nil
end

local function getEquippedTools()
    local out, seen = {}, {}
    local pf = workspace:FindFirstChild("Players")
    if pf then
        local folder = pf:FindFirstChild(plr.Name)
        local tf = folder and folder:FindFirstChild("Tools")
        if tf then
            for _, t in ipairs(tf:GetChildren()) do
                if not seen[t] then seen[t] = true table.insert(out, t) end
            end
        end
    end
    local c = plr.Character
    if c then
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and not seen[t] then seen[t] = true table.insert(out, t) end
        end
    end
    return out
end

local function restoreReach()
    for part, orig in pairs(reachOriginals) do
        if part and part.Parent then
            pcall(function()
                part.Size = orig.Size
                part.Massless = orig.Massless
                if orig.CanCollide ~= nil then part.CanCollide = orig.CanCollide end
            end)
        end
    end
    reachOriginals = {}
end

local function applyPlayerReach()
    if not S.PlayerReachEnabled then restoreReach() return end
    local range = math.clamp(tonumber(S.PlayerReachRange) or 8, 1, 8)
    local active = {}
    for _, tool in ipairs(getEquippedTools()) do
        if not isReachExcluded(tool) then
            local h = findReachHandle(tool)
            if h and h.Parent then
                active[h] = true
                if not reachOriginals[h] then
                    reachOriginals[h] = { Size = h.Size, Massless = h.Massless, CanCollide = h.CanCollide }
                end
                pcall(function()
                    h.Massless = true
                    h.CanCollide = false
                    h.Size = Vector3.new(0.5, 0.5, range)
                end)
            end
        end
    end
    for part in pairs(reachOriginals) do
        if not active[part] then
            if part and part.Parent then
                local orig = reachOriginals[part]
                pcall(function()
                    part.Size = orig.Size
                    part.Massless = orig.Massless
                    part.CanCollide = orig.CanCollide
                end)
            end
            reachOriginals[part] = nil
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if S.PlayerReachEnabled then pcall(applyPlayerReach) end
    end
end)

local function getMeleeEquipped()
    local pf = workspace:FindFirstChild("Players")
    local folder = pf and pf:FindFirstChild(plr.Name)
    local tf = folder and folder:FindFirstChild("Tools")
    if not tf then return false end
    return #tf:GetChildren() > 0
end

local function getAutoHitTargets(range, maxPick)
    local r = getHRP()
    if not r then return {} end
    local detectionRange = range + 10
    local rangeSq = range * range
    local detectionSq = detectionRange * detectionRange
    local out = {}
    for _, other in ipairs(Players:GetPlayers()) do
        if isTargetablePlayer(other) then
            local c = other.Character
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            local eid = c and readEntityId(c)
            if hrp and eid then
                local diff = hrp.Position - r.Position
                local flat = Vector3.new(diff.X, 0, diff.Z)
                local fs = flat:Dot(flat)
                if fs <= rangeSq and fs <= detectionSq and math.abs(diff.Y) <= 20 then
                    table.insert(out, { eid = eid, distSq = fs, pos = hrp.Position })
                end
            end
        end
    end
    table.sort(out, function(a, b) return a.distSq < b.distSq end)
    local trimmed = {}
    for i = 1, math.min(#out, maxPick) do table.insert(trimmed, out[i]) end
    return trimmed
end

local function queueTargets(entries, useSwing)
    if #entries == 0 or not ByteNetReliable then return end
    local r = getHRP()
    if not r then return end
    local maxPick = math.clamp(tonumber(S.PlayerTargetCount) or 1, 1, 9)
    if S.PlayerSwingPacked then
        fireSwingTool(entries, r, { maxPerPacket = maxPick })
    else
        for _, e in ipairs(entries) do fireSwingTool({ e }, r, { maxPerPacket = 1 }) end
    end
    if useSwing then fireClientSwing() end
end

local function startAutoHitLoop()
    if autoHitLoopActive then return end
    autoHitLoopActive = true
    task.spawn(function()
        while S.AutoHitStartEnabled do
            pcall(function()
                local range = S.PlayerReachRange or 8
                local maxPick = math.clamp(tonumber(S.PlayerTargetCount) or 1, 1, 9)
                local targets = getAutoHitTargets(range, maxPick)
                if #targets > 0 then
                    if S.AutoHitSelection == "SwingHit" then
                        if getMeleeEquipped() and not manualAttackLock then queueTargets(targets, true) end
                    else
                        queueTargets(targets, false)
                    end
                end
            end)
            task.wait(S.AutoHitCooldown or 0.05)
        end
        autoHitLoopActive = false
    end)
end

