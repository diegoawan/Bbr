--  Resource / Structure / Critter Aura (SwingTool based)
-- =========================================================
local auraActive = false
local auraState = {
    resCache = {}, resScanAt = 0,
    struCache = {}, struScanAt = 0,
    critCache = {}, critConn, critRemConn, critFolder, critScanAt = 0,
}

local function rescanResources(hrpPos, scanRange)
    table.clear(auraState.resCache)
    local res = workspace:FindFirstChild("Resources")
    if not res then return end
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = { res }
    local parts = workspace:GetPartBoundsInRadius(hrpPos, scanRange, params)
    local seen = {}
    for i = 1, math.min(#parts, 300) do
        local part = parts[i]
        if part and part.Parent then
            local m = part.Parent
            if not m:IsA("Model") then m = part:FindFirstAncestorOfClass("Model") end
            if m and not seen[m] then
                local eid = readEntityId(m)
                local pp = m.PrimaryPart or part
                if eid and pp then
                    seen[m] = true
                    table.insert(auraState.resCache, { model = m, part = pp, eid = eid })
                end
            end
        end
    end
end

local function rescanStructures(hrpPos, scanRange)
    table.clear(auraState.struCache)
    local dep = workspace:FindFirstChild("Deployables")
    if not dep then return end
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = { dep }
    local parts = workspace:GetPartBoundsInRadius(hrpPos, scanRange, params)
    local seen = {}
    for i = 1, math.min(#parts, 250) do
        local part = parts[i]
        if part and part.Parent then
            local m = part:FindFirstAncestorOfClass("Model") or part
            if m and not seen[m] then
                local eid = readEntityId(m)
                local pp = m.PrimaryPart or part
                if eid and pp then
                    seen[m] = true
                    table.insert(auraState.struCache, { model = m, part = pp, eid = eid })
                end
            end
        end
    end
end

local function matchesFilter(modelName, filter, allToken)
    if not modelName then return false end
    filter = tostring(filter or allToken or "")
    local f = string.lower(filter:gsub("^%s+", ""):gsub("%s+$", ""))
    if f == "" or f == "all" or f == string.lower(allToken or "") then return true end
    if string.sub(f, 1, 3) == "all" then return true end
    return string.find(string.lower(modelName), f, 1, true) ~= nil
end

local function collectResourceTargets(hrp, rangeSq, now)
    local res = workspace:FindFirstChild("Resources")
    if not res then return {} end
    local scanRange = math.sqrt(rangeSq) + 25
    if now - auraState.resScanAt > 1.25 then
        auraState.resScanAt = now
        rescanResources(hrp.Position, scanRange)
    end
    local filter = S.ResourceType or "AllResource"
    local out = {}
    for _, d in ipairs(auraState.resCache) do
        if d.model and d.model.Parent and d.part and d.part.Parent then
            local distSq = (d.part.Position - hrp.Position).Magnitude ^ 2
            if distSq <= rangeSq and matchesFilter(d.model.Name, filter, "AllResource") then
                table.insert(out, { eid = d.eid, distSq = distSq, pos = d.part.Position })
            end
        end
    end
    table.sort(out, function(a, b) return a.distSq < b.distSq end)
    return out
end

local function collectStructureTargets(hrp, rangeSq, now)
    if now - auraState.struScanAt > 1.25 then
        auraState.struScanAt = now
        rescanStructures(hrp.Position, math.sqrt(rangeSq) + 25)
    end
    local filter = S.StructureType or "AllStructure"
    local out = {}
    for _, d in ipairs(auraState.struCache) do
        if d.model and d.model.Parent and d.part and d.part.Parent then
            local distSq = (d.part.Position - hrp.Position).Magnitude ^ 2
            if distSq <= rangeSq and matchesFilter(d.model.Name, filter, "AllStructure") then
                table.insert(out, { eid = d.eid, distSq = distSq, pos = d.part.Position })
            end
        end
    end
    table.sort(out, function(a, b) return a.distSq < b.distSq end)
    return out
end

local function ensureCritterWatch()
    local folder = workspace:FindFirstChild("Critters")
    if folder == auraState.critFolder then return end
    if auraState.critConn then auraState.critConn:Disconnect() end
    if auraState.critRemConn then auraState.critRemConn:Disconnect() end
    auraState.critFolder = folder
    table.clear(auraState.critCache)
    if folder then
        for _, m in ipairs(folder:GetDescendants()) do
            if m:IsA("Model") then table.insert(auraState.critCache, m) end
        end
        auraState.critConn = folder.ChildAdded:Connect(function(c)
            if c:IsA("Model") then table.insert(auraState.critCache, c) end
        end)
        auraState.critRemConn = folder.ChildRemoved:Connect(function(c)
            for i = #auraState.critCache, 1, -1 do
                if auraState.critCache[i] == c then table.remove(auraState.critCache, i) end
            end
        end)
    end
end

local function collectCritterTargets(hrp, rangeSq, now)
    ensureCritterWatch()
    local range = S.CritterRange or 15
    local detectionSq = (range + 10) ^ 2
    local filter = S.CritterType or "All"
    local out = {}
    for _, m in ipairs(auraState.critCache) do
        if m and m.Parent then
            local eid = readEntityId(m)
            if eid and matchesFilter(m.Name, filter, "All") then
                local pp = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
                if pp then
                    local distSq = (pp.Position - hrp.Position).Magnitude ^ 2
                    if distSq <= detectionSq then
                        table.insert(out, { eid = eid, distSq = distSq, pos = pp.Position })
                    end
                end
            end
        end
    end
    table.sort(out, function(a, b) return a.distSq < b.distSq end)
    return out
end

local function pickFrom(list, rangeSq, maxPick)
    local out = {}
    for i = 1, math.min(#list, maxPick) do
        if list[i].distSq <= rangeSq + 100 then
            table.insert(out, { eid = list[i].eid, pos = list[i].pos })
        end
    end
    return out
end

local function mergeRows(...)
    local combined, seen = {}, {}
    for i = 1, select("#", ...) do
        for _, r in ipairs(select(i, ...)) do
            local id = math.floor(tonumber(r.eid) or 0)
            if id > 0 and not seen[id] then
                seen[id] = true
                table.insert(combined, r)
            end
        end
    end
    return combined
end

local function startAuraLoop()
    if auraActive then return end
    if not (S.ResourceAuraEnabled or S.StructureAuraEnabled or S.CritterAuraEnabled) then return end
    auraActive = true
    task.spawn(function()
        while S.ResourceAuraEnabled or S.StructureAuraEnabled or S.CritterAuraEnabled do
            pcall(function()
                local hrp = getHRP()
                if not hrp then return end
                local now = tick()
                local maxPick = math.clamp(tonumber(S.TargetCount) or 3, 1, 9)
                local rows = {}

                if S.ResourceAuraEnabled then
                    local range = S.ResourceRange or 15
                    local rSq = range * range
                    local list = collectResourceTargets(hrp, rSq, now)
                    local picked = pickFrom(list, rSq, maxPick)
                    rows = mergeRows(rows, picked)
                end

                if S.StructureAuraEnabled then
                    local range = S.ResourceRange or 15
                    local rSq = range * range
                    local list = collectStructureTargets(hrp, rSq, now)
                    local picked = pickFrom(list, rSq, maxPick)
                    rows = mergeRows(rows, picked)
                end

                if S.CritterAuraEnabled then
                    local rSq = (S.CritterRange or 15) ^ 2
                    local list = collectCritterTargets(hrp, rSq, now)
                    local picked = pickFrom(list, rSq, maxPick)
                    rows = mergeRows(rows, picked)
                end

                if #rows > 0 then
                    fireSwingTool(rows, hrp, { maxPerPacket = math.min(9, maxPick * 3) })
                    if S.AuraLegitSwing then
                        fireClientSwing()
                    end
                end
            end)
            task.wait(S.ResourceCooldown or 0.03)
        end
        auraActive = false
    end)
end

