local function readEntityId(inst)
    if not inst then return nil end
    for _, key in ipairs({ "EntityID","NetworkId","networkId","NetworkID","ID","Id","Eid","EntityId" }) do
        local v = inst:GetAttribute(key)
        if v ~= nil then
            local n = math.floor(tonumber(v) or 0)
            if n > 0 then return n end
        end
    end
    for _, val in pairs(inst:GetAttributes()) do
        if typeof(val) == "number" and val > 1000 then return math.floor(val) end
    end
    local v = inst:FindFirstChildWhichIsA("IntValue", true) or inst:FindFirstChildWhichIsA("NumberValue", true)
    if v and v.Value > 1000 then return math.floor(v.Value) end
    return nil
end

local function getBoogaChar(player)
    if not player then return nil end
    local pf = workspace:FindFirstChild("Players")
    if pf then
        local custom = pf:FindFirstChild(player.Name)
        if custom then return custom end
    end
    return player.Character
end

local function getBoogaHRP(player)
    local c = getBoogaChar(player)
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart")
        or c:FindFirstChild("Hitbox")
        or c:FindFirstChildWhichIsA("BasePart")
end

local function isAlly(player)
    if not player or player == plr then return false end
    local myTeam = plr.Team
    local theirTeam = player.Team
    if not myTeam or not theirTeam then return false end
    if theirTeam.Name == "NoTribe" then return false end
    if myTeam.Name == "NoTribe" then return false end
    return myTeam == theirTeam
end

local function isTargetablePlayer(p)
    if not p or p == plr then return false end
    if not p.Character then return false end
    if isAlly(p) then return false end
    return true
end

