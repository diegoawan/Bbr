craftNameToID = {}
craftItemIDs = {}
do
    task.spawn(function()
        local mf = ReplicatedStorage:WaitForChild("Modules", 20)
        if not mf then return end
        local ii = mf:WaitForChild("ItemIDS", 20)
        if not ii then return end
        local ok, mod = pcall(require, ii)
        if not ok or type(mod) ~= "table" then return end
        local isNameToID = false
        for k, v in pairs(mod) do
            if type(k) == "string" and type(v) == "number" then isNameToID = true break end
        end
        if isNameToID then
            for n, id in pairs(mod) do craftNameToID[n] = id craftItemIDs[id] = n end
        else
            for id, n in pairs(mod) do craftItemIDs[id] = n craftNameToID[n] = id end
        end
    end)
end

function autoDiscoverItemID(itemName)
    if not itemName or itemName == "" then return nil end
    local cached = craftNameToID[itemName]
    if cached ~= nil then return cached end
    return nil
end

