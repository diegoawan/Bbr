--  Gold Farm (Tween Circuit)
-- =========================================================
local goldActive = false
local currentWaypoint = 1
local movementConn

local function rayParams()
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    if plr.Character then rp.FilterDescendantsInstances = { plr.Character } end
    return rp
end

local function wouldTweenHitTerrain(startPos, endPos)
    local rp = rayParams()
    local dir = endPos - startPos
    for i = 0, 3 do
        local t = i / 3
        local sample = startPos + dir * t
        local hit = workspace:Raycast(sample, Vector3.new(0, -5, 0), rp)
        if hit and sample.Y < hit.Position.Y then return true end
    end
    return false
end

local function isPathClear(startPos, endPos)
    local rp = rayParams()
    local dir = (endPos - startPos).Unit
    local rayOrigin = startPos + Vector3.new(0, 2, 0)
    local rayDir = (endPos + Vector3.new(0, 2, 0)) - rayOrigin
    local hit = workspace:Raycast(rayOrigin, rayDir, rp)
    if hit then
        local hd = (hit.Position - rayOrigin).Magnitude
        if hd < (endPos - startPos).Magnitude * 0.9 then return false end
    end
    return true
end

local function startMovementEngine()
    if movementConn then return end
    movementConn = RunService.Heartbeat:Connect(function()
        if not S.GoldCircuitEnabled then return end
        if #S.RecordedPositions == 0 then return end
        local hrp = getHRP()
        local h = getHum()
        if not hrp or not h then return end
        if currentWaypoint > #S.RecordedPositions then currentWaypoint = 1 end
        local wp = S.RecordedPositions[currentWaypoint]
        if not wp then return end
        local target = Vector3.new(wp.X or wp.x, wp.Y or wp.y, wp.Z or wp.z)
        local dist = (target - hrp.Position).Magnitude
        if dist <= 3 then
            local waitTime = wp.waitTime or 0
            if waitTime > 0 then
                task.wait(waitTime)
            end
            currentWaypoint += 1
            if currentWaypoint > #S.RecordedPositions then currentWaypoint = 1 end
            return
        end

        local baseSpeed = tonumber(S.GoldSpeed) or 21
        local heightDiff = target.Y - hrp.Position.Y
        local shouldTween = S.TweenOnly or wouldTweenHitTerrain(hrp.Position, target) or heightDiff > 6 or not isPathClear(hrp.Position, target)

        if shouldTween then
            if not alignPosition then createAlignPosition(hrp) end
            alignAttachment1.WorldPosition = target
            alignPosition.MaxVelocity = baseSpeed
            isTweening = true
            noclipChar()
        else
            walkToWaypoint(hrp, h, target, baseSpeed)
        end
        h.WalkSpeed = S.WalkSpeedEnabled and S.WalkSpeed or baseSpeed
    end)
end

local function stopGoldCircuit()
    S.GoldCircuitEnabled = false
    if movementConn then
        movementConn:Disconnect()
        movementConn = nil
    end
    local hrp = getHRP()
    if hrp then
        local bv = hrp:FindFirstChild("CrystallizedBodyVelocity")
        if bv then bv:Destroy() end
        local bg = hrp:FindFirstChild("CrystallizedBodyGyro")
        if bg then bg:Destroy() end
    end
    if alignPosition then alignPosition:Destroy() alignPosition = nil end
    if alignAttachment0 then alignAttachment0:Destroy() alignAttachment0 = nil end
    if alignAttachment1 then alignAttachment1:Destroy() alignAttachment1 = nil end
    isTweening = false
    restoreCollision()
    goldActive = false
end

local function startGoldCircuit()
    if goldActive then return end
    goldActive = true
    startMovementEngine()
    task.spawn(function()
        while S.GoldCircuitEnabled do task.wait(0.5) end
        stopGoldCircuit()
    end)
end

