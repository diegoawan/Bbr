local plantActive = false
local function getPlantBoxesCached()
    local dep = workspace:FindFirstChild("Deployables")
    if not dep then return {} end
    local out = {}
    for _, m in ipairs(dep:GetChildren()) do
        if m:IsA("Model") and m.Name == "Plant Box" then table.insert(out, m) end
    end
    return out
end

local function hasSeed(model)
    return model:FindFirstChild("Seed") ~= nil
end

local function startPlantLoop()
    if plantActive then return end
    plantActive = true
    task.spawn(function()
        while S.PlantEnabled or S.CachePlantBoxes or S.CacheWalk do
            pcall(function()
                local hrp = getHRP(); if not hrp then return end
                local range = S.PlantRange or 20
                local rSq = range * range
                local boxes = getPlantBoxesCached()
                local empties = {}
                for _, m in ipairs(boxes) do
                    if not hasSeed(m) then
                        local pp = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
                        if pp then
                            local d = (pp.Position - hrp.Position).Magnitude
                            if d <= range then table.insert(empties, { model = m, part = pp, dist = d }) end
                        end
                    end
                end
                table.sort(empties, function(a, b) return a.dist < b.dist end)
                if S.PlantEnabled then
                    local fruits = {}
                    for k, v in pairs(S.PlantFruit) do
                        if v then table.insert(fruits, k) end
                    end
                    if #fruits == 0 then fruits = { "Bloodfruit" } end
                    local fruit = fruits[1]
                    local itemID = autoDiscoverItemID(fruit .. " Seed") or autoDiscoverItemID(fruit)
                    if itemID then
                        for i = 1, math.min(#empties, 8) do
                            local eid = readEntityId(empties[i].model)
                            if eid then fireInteractStructure(eid, itemID) end
                        end
                    end
                end
            end)
            task.wait(S.PlantDelay or 0.05)
        end
        plantActive = false
    end)
end

local harvestActive = false
local function startHarvestLoop()
    if harvestActive then return end
    harvestActive = true
    task.spawn(function()
        while S.HarvestEnabled do
            pcall(function()
                local hrp = getHRP(); if not hrp then return end
                local crops = workspace:FindFirstChild("Crops"); if not crops then return end
                local range = S.HarvestRange or 30
                local rSq = range * range
                local attempted = {}
                for _, m in ipairs(crops:GetDescendants()) do
                    if m:IsA("Model") then
                        local pp = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
                        if pp and (pp.Position - hrp.Position).Magnitude ^ 2 <= rSq then
                            local eid = readEntityId(m)
                            if eid and not attempted[eid] then
                                attempted[eid] = true
                                firePickup(eid)
                            end
                        end
                    end
                end
            end)
            task.wait(0.1)
        end
        harvestActive = false
    end)
end

